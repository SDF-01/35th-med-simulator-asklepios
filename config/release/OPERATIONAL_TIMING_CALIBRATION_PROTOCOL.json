{
  "schema_version": "1.0.0",
  "protocol_id": "asklepios-clinical-timing-calibration-protocol-v1",
  "current_status": "NOT_CALIBRATED",
  "current_transferability": "NOT_ESTABLISHED",
  "scope": "FUTURE_REAL_WORLD_CLINICAL_TIMING_TRANSFER_CLAIMS",
  "simulation_release_dependency": "NOT_REQUIRED_FOR_PRODUCTION_HEALTHCARE_SIMULATION_SOFTWARE_READINESS",
  "prohibited_shortcuts": [
    "single_site_convenience_sample",
    "training_log_as_clinical_ground_truth",
    "point_estimate_without_uncertainty",
    "in_sample_only_evaluation",
    "manual_parameter_promotion_without_versioned_evidence",
    "simulation_latency_interpreted_as_clinical_deadline"
  ],
  "required_study_design": {
    "prospective_protocol": true,
    "versioned_multisite_dataset": true,
    "independent_holdout": true,
    "temporal_holdout": true,
    "site_level_holdout": true,
    "predefined_inclusion_exclusion": true,
    "missingness_analysis": true,
    "data_quality_audit": true,
    "independent_sme_approval": true
  },
  "required_dataset_manifest": [
    "dataset_version",
    "collection_period",
    "sites",
    "care_settings",
    "population_definition",
    "sample_size",
    "missingness_by_field",
    "measurement_process",
    "exclusion_log",
    "governance_approval"
  ],
  "required_estimands": [
    "median_elapsed_time",
    "p90_elapsed_time",
    "p95_elapsed_time",
    "tail_event_probability",
    "site_level_variation",
    "subgroup_variation"
  ],
  "required_uncertainty": {
    "confidence_level": 0.95,
    "bootstrap_or_valid_asymptotic_interval": true,
    "cluster_by_site": true,
    "multiple_comparison_control_for_promotion": true
  },
  "required_validation": {
    "held_out_calibration_error": true,
    "coverage_of_prediction_intervals": true,
    "sensitivity_to_missingness": true,
    "sensitivity_to_outliers": true,
    "distribution_shift_analysis": true,
    "external_reproduction": true
  },
  "promotion_rules": {
    "all_required_artifacts_authenticated": true,
    "all_predefined_acceptance_criteria_met": true,
    "no_material_site_or_subgroup_failure": true,
    "independent_review_complete": true,
    "versioned_applicability_statement_required": true,
    "automatic_promotion_permitted": false
  },
  "post_promotion_monitoring": {
    "drift_metrics_required": true,
    "site_specific_monitoring_required": true,
    "recalibration_trigger_required": true,
    "rollback_threshold_required": true,
    "periodic_independent_review_required": true
  }
}
