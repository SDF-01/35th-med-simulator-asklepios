{
  "schema_version": "1.0.0",
  "policy_id": "asklepios-ci-portability-policy-v1",
  "policy_epoch": 1,
  "scope": "CROSS_PLATFORM_RELEASE_ASSURANCE_AND_GITHUB_ACTIONS",
  "workspace_path_profile": "CONTENT_ADDRESSED_COMPACT_WORKSPACE_PATHS_V1",
  "workspace_component_hash_hex": 20,
  "portable_windows_path_budget": 240,
  "preferred_temporary_root_environment": "RUNNER_TEMP",
  "compact_roots": {
    "mutation": "m",
    "heavy": "h",
    "source": "src",
    "checkpoint": "cp"
  },
  "checkpoint_identity_includes_workspace_profile": true,
  "internal_error_requires_durable_diagnostics": true,
  "windows_command_boundary": "EXPLICIT_CMD_EXE_FOR_COMMAND_SHIMS_V1",
  "text_identity": {
    "line_endings": "LF",
    "utf8_bom": "PROHIBITED",
    "windows_backslash_repository_paths": "PROHIBITED"
  },
  "required_windows_jobs": [
    "facility-runtime-windows",
    "facility-decision-runtime-windows",
    "standalone-windows"
  ],
  "known_failure_classes_structurally_blocked": [
    "UNBOUNDED_CASE_ID_DIRECTORY_NAMES",
    "WINDOWS_PATH_LENGTH_OVERFLOW",
    "LIVE_WORKING_TREE_WORKER_EXECUTION",
    "UNBOUND_CHECKPOINT_WORKSPACE_PROFILE",
    "MISSING_INTERNAL_ERROR_DIAGNOSTICS",
    "WINDOWS_NPM_SHIM_IMPLICIT_RESOLUTION",
    "CRLF_IDENTITY_DRIFT",
    "UTF8_BOM_IDENTITY_DRIFT",
    "WINDOWS_SEPARATOR_PATH_ESCAPE"
  ],
  "truth_boundary": "The policy structurally prevents the enumerated cross-platform failure classes. It does not prove that every possible future CI or platform failure is impossible.",
  "policy_sha256": "fefc09d47e9ade7a297a8f16bd056c65216b4f36f78b82a37aeae8896e924968"
}
