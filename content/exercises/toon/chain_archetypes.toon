meta:
  version: 1
  description: Multi-role segment chains for Asklepios exercise catalog generation

archetypes[9]{id,label,minProviders,estimatedMinutes,difficulty}:
  FIELD_TO_OR,Field to definitive care,4,35,intermediate
  MCI_SURGE,Mass casualty surge,4,30,intermediate
  CLINIC_DIAGNOSTIC,Clinic diagnostics chain,3,25,intro
  CBRNE_CHAIN,CBRNE decon to treatment,5,40,advanced
  ENVIRONMENTAL,Environmental injury pathway,3,20,intro
  AVIATION,Aviation mishap response,4,35,intermediate
  GARRISON_CLINIC,Garrison clinic workflow,2,20,intro
  DEPLOYED_AUSTERE,Deployed austere care,4,35,advanced
  HA_DR,Humanitarian assistance chain,4,30,intermediate

segment_steps[36]{archetypeId,order,department,label,briefingLead,isEntry,isTerminal}:
  FIELD_TO_OR,1,field_response_team,Point of injury: MARCH,Establish scene safety and perform initial MARCH assessment under threat.,true,false
  FIELD_TO_OR,2,transport,CASEVAC en route,Maintain hemorrhage control and monitor during movement to the treatment facility.,false,false
  FIELD_TO_OR,3,clinical_immediate,Clinical immediate bay,Stabilize the casualty order diagnostics and prepare disposition.,false,false
  FIELD_TO_OR,4,radiology,Urgent imaging,Prioritize and communicate critical imaging findings.,false,false
  FIELD_TO_OR,5,surgery,Operative triage and pre-op,Accept surgical handoff and establish operative priority.,false,true
  MCI_SURGE,1,triage,Mass casualty triage,Sort tag and assign casualties to treatment lanes under surge.,true,false
  MCI_SURGE,2,clinical_immediate,Immediate treatment lane,Treat the highest-acuity casualty from triage handoff.,false,false
  MCI_SURGE,3,clinical_delayed,Delayed treatment lane,Manage urgent casualties that can wait briefly for definitive care.,false,false
  MCI_SURGE,4,transport,CASEVAC coordination,Coordinate evacuation for stabilized casualties.,false,true
  CLINIC_DIAGNOSTIC,1,clinical_immediate,Clinical immediate assessment,Perform primary assessment orders and escalation planning.,true,false
  CLINIC_DIAGNOSTIC,2,lab,Critical values processing,Process stat labs and communicate critical results.,false,false
  CLINIC_DIAGNOSTIC,3,radiology,Diagnostic imaging,Complete urgent imaging and report findings to clinical team.,false,false
  CLINIC_DIAGNOSTIC,4,pharm,Medication reconciliation,Verify orders allergies and medication safety under surge.,false,true
  CBRNE_CHAIN,1,triage,CBRNE triage and routing,Identify exposure route and route casualties to decon or treatment.,true,false
  CBRNE_CHAIN,2,decon,Decontamination corridor,Perform decon and exposure assessment before clinical handoff.,false,false
  CBRNE_CHAIN,3,clinical_immediate,Clinical treatment post-decon,Stabilize symptomatic casualties after decontamination.,false,false
  CBRNE_CHAIN,4,lab,Exposure laboratory workup,Process specimens and communicate critical values.,false,false
  CBRNE_CHAIN,5,pharm,Antidote and medication support,Verify antidote and supportive medication orders.,false,true
  ENVIRONMENTAL,1,clinical_immediate,Environmental emergency assessment,Assess heat cold or smoke-related injury and initiate treatment.,true,false
  ENVIRONMENTAL,2,clinical_delayed,Continued monitoring,Monitor and re-assess during observation period.,false,false
  ENVIRONMENTAL,3,transport,Evacuation when indicated,Coordinate transport for casualties requiring higher care.,false,true
  AVIATION,1,field_response_team,Flightline emergency response,Respond to aircraft mishap with burn and blunt trauma priorities.,true,false
  AVIATION,2,clinical_immediate,Clinical burn and trauma bay,Stabilize aviation casualty with burn and trauma protocols.,false,false
  AVIATION,3,radiology,Trauma imaging,Prioritize trauma imaging and communicate findings.,false,false
  AVIATION,4,surgery,Surgical evaluation,Accept handoff for operative intervention if indicated.,false,true
  GARRISON_CLINIC,1,clinical_immediate,Garrison clinic intake,Assess clinic casualty and initiate treatment orders.,true,false
  GARRISON_CLINIC,2,lab,Outpatient laboratory,Process ordered labs and call critical values.,false,false
  GARRISON_CLINIC,3,pharm,Pharmacy verification,Reconcile medications and verify safety.,false,true
  DEPLOYED_AUSTERE,1,field_response_team,Forward point of injury,Care under fire and far-forward stabilization.,true,false
  DEPLOYED_AUSTERE,2,triage,Forward triage,Sort casualties with limited resources and ongoing threat.,false,false
  DEPLOYED_AUSTERE,3,clinical_immediate,Role 2 clinical care,Definitive care at forward surgical team or equivalent.,false,false
  DEPLOYED_AUSTERE,4,transport,Strategic evacuation,Prepare and hand off for evacuation to higher echelon.,false,true
  HA_DR,1,triage,Disaster triage site,Establish triage in disaster-affected area.,true,false
  HA_DR,2,clinical_immediate,Emergency treatment,Stabilize casualties from structural or environmental disaster.,false,false
  HA_DR,3,patient_administration,Casualty tracking,Register track and coordinate patient administration.,false,false
  HA_DR,4,transport,Evacuation coordination,Coordinate movement to definitive care facilities.,false,true
