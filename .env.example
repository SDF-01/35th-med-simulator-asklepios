# Optional: force role entry on / (local dev uses separate Vite modes instead)
# VITE_ENTRY_MODE=provider
# VITE_ENTRY_MODE=wit

# Optional: only when the hub runs on a DIFFERENT host than the SPA.
# Leave empty for same-origin hub (SPA served from hub `dist/`, or local Vite proxy).
# Production (Cloudflare Pages + Render hub): set to your Render hub origin.
# VITE_HUB_URL=https://asklepios-hub.onrender.com

# ─── Hub server (local dev, Render, Railway, or other Node host) ───

# Port (Render/Railway set PORT automatically)
# PORT=3021
# ASKLEPIOS_HUB_PORT=3021

# Comma-separated allowed browser origins for CORS + Socket.IO (required in production).
# Cloudflare Pages + Render hub: list the Pages origin (and localhost for testing).
# Single Render (SPA from dist): list this service's public HTTPS origin.
# ASKLEPIOS_CORS_ORIGIN=https://asklepios.pages.dev,https://asklepios-hub.onrender.com,http://localhost:5183,http://localhost:5184

# Optional future server-side narrative model adapter. Never prefix secrets with VITE_.
# ASKLEPIOS_SCENARIO_MODEL_URL=https://your-private-model-gateway.example/v1/scenario-draft
# ASKLEPIOS_SCENARIO_MODEL_TOKEN=
# ASKLEPIOS_SCENARIO_MODEL_ID=
