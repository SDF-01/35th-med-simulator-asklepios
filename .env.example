# Optional: force role entry on / (local dev uses separate Vite modes instead)
# VITE_ENTRY_MODE=provider
# VITE_ENTRY_MODE=wit

# Optional: only when the hub runs on a DIFFERENT host than the Vercel SPA.
# Leave empty for same-origin hub (api/hub.ts on Vercel) or local dev (Vite proxy).
# VITE_HUB_URL=https://your-hub.example.com

# ─── Hub server (local dev, optional dedicated host, or Vercel api/hub.ts) ───

# Port (Render/Railway set PORT automatically; Vercel sets PORT in functions)
# PORT=3021
# ASKLEPIOS_HUB_PORT=3021

# Comma-separated allowed browser origins for CORS + Socket.IO (dedicated hub only)
# ASKLEPIOS_CORS_ORIGIN=https://project-asklepios.vercel.app,http://localhost:5183,http://localhost:5184


# Optional future server-side narrative model adapter. Never prefix secrets with VITE_.
# ASKLEPIOS_SCENARIO_MODEL_URL=https://your-private-model-gateway.example/v1/scenario-draft
# ASKLEPIOS_SCENARIO_MODEL_TOKEN=
# ASKLEPIOS_SCENARIO_MODEL_ID=
