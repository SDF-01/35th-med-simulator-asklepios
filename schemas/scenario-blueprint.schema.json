{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-asklepios.invalid/schemas/scenario-blueprint.schema.json",
  "title": "Scenario Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blueprint_id",
    "blueprint_version",
    "mode",
    "source_scenario_id",
    "allowed_topics",
    "mutable_paths",
    "route_template_id"
  ],
  "properties": {
    "blueprint_id": { "type": "string", "minLength": 1 },
    "blueprint_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "mode": { "const": "template_locked" },
    "source_scenario_id": { "type": "string", "minLength": 1 },
    "allowed_topics": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "mutable_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "location_options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "weather_options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "visibility_options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "communications_options": { "type": "array", "minItems": 1, "items": { "enum": ["normal", "degraded", "intermittent", "unavailable"] } },
    "resource_options": { "type": "array", "minItems": 1, "items": { "enum": ["normal", "constrained", "overwhelmed"] } },
    "resource_event_options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "route_template_id": { "type": "string", "minLength": 1 }
  }
}
