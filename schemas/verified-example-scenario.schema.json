{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-asklepios.invalid/schemas/verified-example-scenario.schema.json",
  "title": "Project Asklepios canonical verified example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example_id",
    "purpose",
    "source_bindings",
    "authority",
    "protected_template",
    "scenario",
    "route_summary",
    "certificate",
    "citations",
    "validity_ledger",
    "claim_language",
    "documentation",
    "hashing",
    "example_manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "example_id": {"const": "ASK-EXAMPLE-RC3-2"},
    "purpose": {"type": "string", "minLength": 1},
    "source_bindings": {"type": "object"},
    "authority": {
      "type": "object",
      "required": ["clinical_authority", "deployment_scope", "evidence_authority"],
      "properties": {
        "clinical_authority": {"const": "NOT_GRANTED"},
        "deployment_scope": {"const": "research_sandbox_only"},
        "evidence_authority": {"const": "supporting_only"}
      }
    },
    "protected_template": {"type": "object"},
    "scenario": {"type": "object"},
    "route_summary": {"type": "object"},
    "certificate": {"type": "object"},
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "doi",
          "chunk_sha256",
          "source_file_sha256",
          "relation",
          "identity_verification",
          "entailment_status",
          "contradiction_status",
          "human_review_status",
          "clinical_authority"
        ],
        "properties": {
          "relation": {"const": "REFERENCE_ONLY"},
          "identity_verification": {"const": "PASS"},
          "entailment_status": {"const": "NOT_ADJUDICATED"},
          "contradiction_status": {"const": "NOT_SEARCHED"},
          "human_review_status": {"const": "NOT_REVIEWED"},
          "clinical_authority": {"const": "NOT_GRANTED"}
        }
      }
    },
    "validity_ledger": {"type": "array", "minItems": 1},
    "claim_language": {"type": "object"},
    "documentation": {"type": "object"},
    "hashing": {"type": "object"},
    "example_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
