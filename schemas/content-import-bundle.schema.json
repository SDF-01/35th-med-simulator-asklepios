{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-asklepios.local/schemas/content-import-bundle.schema.json",
  "title": "Project Asklepios staged content import bundle",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "namespace",
    "source_kind",
    "activation_status",
    "assets",
    "relations",
    "evidence_attestations",
    "claim_candidates",
    "compatibility_hints",
    "roots",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "activation_status": {
      "const": "STAGED_NOT_ACTIVE"
    },
    "source_kind": {
      "enum": [
        "evidence_identity",
        "repository_content",
        "operational_calibration_candidate",
        "human_performance_candidate",
        "reviewed_template_candidate"
      ]
    }
  }
}
