{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/hub.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/hub" },
    { "source": "/socket.io/:path*", "destination": "/api/hub" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
